[Unit]
Description=Yenten pool: charts data collector (hash rate, difficulty, miners, workers on the home page)
After=ytn-pool-redis.service ytn-pool-api.service
Requires=ytn-pool-redis.service
[Service]
Type=simple
User=ytnpool
WorkingDirectory=/opt/ytn-nodejs-pool
ExecStart=/usr/bin/node /opt/ytn-nodejs-pool/init.js -module=chartsDataCollector
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
