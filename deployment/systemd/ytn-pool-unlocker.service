[Unit]
Description=Yenten pool: block unlocker (credits the miners after the coinbase maturity)
After=ytn-pool-redis.service ytn-node.service
Requires=ytn-pool-redis.service
[Service]
Type=simple
User=ytnpool
WorkingDirectory=/opt/ytn-nodejs-pool
ExecStart=/usr/bin/node /opt/ytn-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
