{
  "poolHost": "pool.example.org",
  "coin": "VerusCoin",
  "symbol": "VRSC",
  "coinUnits": 100000000,
  "coinDecimalPlaces": 8,
  "coinDifficultyTarget": 60,
  "blockchainExplorer": "https://explorer.verus.io/block/{id}",
  "transactionExplorer": "https://explorer.verus.io/tx/{id}",
  "logging": {
    "files": {
      "level": "info",
      "directory": "logs",
      "flushInterval": 5
    },
    "console": {
      "level": "info",
      "colors": true
    }
  },
  "poolServer": {
    "enabled": true,
    "mergedMining": false,
    "clusterForks": 1,
    "minerTimeout": 240,
    "sslCert": "/etc/ssl/fullchain.pem",
    "sslKey": "/etc/ssl/privkey.pem",
    "sslCA": "./chain.pem",
    "ports": [
      {
        "port": 5150,
        "desc": "VRSC stratum (plain TCP, difficulty adjusts to your hashrate)"
      },
      {
        "port": 5151,
        "desc": "VRSC stratum over TLS (encrypted)",
        "tls": true
      },
      {
        "port": 5152,
        "desc": "VRSC stratum over TLS (alternative port)",
        "tls": true
      },
      {
        "port": 5153,
        "desc": "VRSC stratum over TLS (alternative port)",
        "tls": true
      }
    ],
    "banning": {
      "enabled": true,
      "time": 600,
      "invalidPercent": 25,
      "checkThreshold": 30
    },
    "slushMining": {
      "enabled": true,
      "weight": 86400
    },
    "bindIp": "0.0.0.0",
    "allowIPs": [],
    "maxConnectionsPerIp": 100,
    "maxUnauthenticatedPerIp": 10,
    "loginTimeout": 20,
    "maxConnections": 3000,
    "varDiff": {
      "startDiff": 100,
      "minDiff": 10,
      "maxDiff": 2000000,
      "targetTime": 20,
      "retargetTime": 60,
      "variancePercent": 30,
      "maxJump": 100
    },
    "jobRefresh": 1000,
    "poolAddress": "YOUR_POOL_ADDRESS",
    "templateRefresh": 30,
    "coinbaseTag": "/pool.example.org/"
  },
  "payments": {
    "enabled": true,
    "interval": 600,
    "minPayment": 10000000,
    "maxTransactionAmount": 100000000000,
    "maxPaymentsPerRound": 50,
    "minConfirmations": 6,
    "pendingTimeoutHours": 48,
    "reserve": 100000,
    "minerPayFee": true,
    "dryRun": true,
    "onlyAccounts": [],
    "stopFile": "/opt/vrsc-nodejs-pool/STOP_PAYMENTS"
  },
  "blockUnlocker": {
    "enabled": true,
    "interval": 60,
    "depth": 110,
    "poolFee": 1,
    "networkFee": 0,
    "donations": {}
  },
  "api": {
    "enabled": true,
    "hashrateWindow": 600,
    "updateInterval": 5,
    "bindIp": "127.0.0.1",
    "port": 8144,
    "blocks": 30,
    "payments": 30,
    "password": "CHANGE_ME",
    "ssl": false,
    "sslPort": 8120,
    "sslCert": "./cert.pem",
    "sslKey": "./privkey.pem",
    "sslCA": "./chain.pem",
    "trustProxyIP": true
  },
  "redis": {
    "host": "127.0.0.1",
    "port": 6402,
    "auth": "CHANGE_ME",
    "db": 0,
    "cleanupInterval": 15
  },
  "prices": {
    "source": "tradeogre",
    "currency": "USD"
  },
  "charts": {
    "pool": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "miners": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "workers": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "difficulty": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "price": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      },
      "profit": {
        "enabled": true,
        "updateInterval": 1800,
        "stepInterval": 10800,
        "maximumPeriod": 604800
      }
    },
    "user": {
      "hashrate": {
        "enabled": true,
        "updateInterval": 180,
        "stepInterval": 1800,
        "maximumPeriod": 86400
      },
      "worker_hashrate": {
        "enabled": true,
        "updateInterval": 60,
        "stepInterval": 60,
        "maximumPeriod": 86400
      },
      "payments": {
        "enabled": true
      }
    },
    "blocks": {
      "enabled": true,
      "days": 30
    }
  },
  "node": {
    "host": "127.0.0.1",
    "port": 7771,
    "user": "vrscpool",
    "passwordFile": "/opt/vrsc/data/rpc.pass"
  },
  "hasher": {
    "path": "/opt/vrsc-nodejs-pool/hasher/verushash",
    "threads": 2
  },
  "mmrTool": {
    "path": "/opt/vrsc-nodejs-pool/mmrtool/mmrtool",
    "libDir": "/opt/vrsc-nodejs-pool/mmrtool"
  },
  "addressVersion": 60,
  "scriptAddressVersion": 85,
  "bech32Hrp": "novrsc-bech32-addresses-exist"
}
